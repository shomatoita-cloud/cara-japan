    <symbol id="i-pages" viewBox="0 0 24 24"><path d="M8 3h9a2 2 0 012 2v12"/><rect x="5" y="7" width="12" height="14" rx="2"/></symbol>
    <symbol id="i-flask" viewBox="0 0 24 24"><path d="M10 3h4M11 3v6l-6 10a1.5 1.5 0 001.3 2.3h11.4A1.5 1.5 0 0019 19L13 9V3"/><path d="M8 15h8"/></symbol>
    <symbol id="i-list" viewBox="0 0 24 24"><path d="M9 6h11M9 12h11M9 18h11"/><circle cx="4.5" cy="6" r="1"/><circle cx="4.5" cy="12" r="1"/><circle cx="4.5" cy="18" r="1"/></symbol>
