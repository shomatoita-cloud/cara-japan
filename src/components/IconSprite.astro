    <symbol id="i-yen" viewBox="0 0 24 24"><circle cx="12" cy="12" r="8.5"/><path d="M9 7.5l3 4.5 3-4.5M12 12v5M9.5 13.5h5M9.5 15.8h5"/></symbol>
    <symbol id="i-link" viewBox="0 0 24 24"><path d="M9.5 14.5l5-5"/><path d="M11 7.5l1.8-1.8a3.5 3.5 0 015 5L16 12.5"/><path d="M13 16.5l-1.8 1.8a3.5 3.5 0 01-5-5L8 11.5"/></symbol>
