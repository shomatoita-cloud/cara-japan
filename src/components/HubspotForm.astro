---
/**
 * HubspotForm.astro — HubSpotフォームの唯一の埋め込み口。
 * 自前のフォーム(<form>/送信処理)は実装しない。
 *
 * 埋め込みは HubSpot の新形式:
 *   <script src="https://js-{region}.hsforms.net/forms/embed/{portalId}.js" defer></script>
 *   <div class="hs-form-frame" data-region data-form-id data-portal-id></div>
 * スクリプトはページ内のフォーム数によらず1回だけ読み込む(下の重複ガードを参照)。
 *
 * portalId / formId が未設定のあいだは、モック(.form-mock)のプレースホルダーを表示する。
 * 送信後の遷移先(/thanks/[slug])は HubSpot 側の設定で行う。
 */
import { HUBSPOT, isHubspotConfigured } from '../consts';

interface Props {
  portalId?: string;
  formId?: string;
  region?: string;
  /** プレースホルダー時に表示するダミー項目 */
  placeholderFields?: { label: string; value?: string }[];
  class?: string;
}

const {
  portalId = HUBSPOT.portalId,
  formId = '',
  region = HUBSPOT.region,
  placeholderFields = [
    { label: '会社名' },
    { label: '氏名' },
    { label: 'メールアドレス' },
    { label: '興味のある内容', value: '資料ダウンロード / デモ / 個別相談' },
  ],
  class: className,
} = Astro.props;

const isConfigured = isHubspotConfigured(formId, portalId);

// region 未指定のアカウントは region なしのホスト(js.hsforms.net)になる
const embedSrc = region
  ? `https://js-${region}.hsforms.net/forms/embed/${portalId}.js`
  : `https://js.hsforms.net/forms/embed/${portalId}.js`;

// ローダー。同一ページに複数フォームがあっても src が同じなら1回しか読み込まない。
// (HubSpotのスクリプトはページ内の .hs-form-frame をまとめて処理するため、1本で足りる)
const loaderScript = `(function(){
  var src = ${JSON.stringify(embedSrc)};
  if (document.querySelector('script[src="' + src + '"]')) return;
  var s = document.createElement('script');
  s.src = src;
  s.defer = true;
  document.head.appendChild(s);
})();`;
---

{
  isConfigured ? (
    <div class:list={['hs-form', className]}>
      <div class="hs-form-frame" data-region={region} data-form-id={formId} data-portal-id={portalId} />
      <script is:inline set:html={loaderScript} />
    </div>
  ) : (
    /* 未設定時: モックの .form-mock をそのまま表示(入力はできない) */
    <div class:list={['form-mock', className]} aria-hidden="true">
      {placeholderFields.map((f) => (
        <Fragment>
          <label>{f.label}</label>
          {f.value ? <div class="field ta">{f.value}</div> : <div class="field" />}
        </Fragment>
      ))}
    </div>
  )
}

<style>
  /* プレースホルダーと実フォームで白カードの寸法を揃える。
     下層ページ側の上書き(.dl-card / .apply-form-block)は両方を対象にしているため、
     ここを共通にしておけば実フォームに切り替わってもレイアウトが変わらない。 */
  .form-mock,
  .hs-form{
    max-width:540px;margin:0 auto 36px;background:#fff;border:1px solid var(--line);
    border-radius:20px;padding:34px;text-align:left;box-shadow:0 30px 66px rgba(15,40,90,.3);
    position:relative;z-index:2;
  }
  /* HubSpotが差し込むフォームはカード幅いっぱいに広げる */
  .hs-form-frame{width:100%}
  .form-mock label{font-size:12.5px;font-weight:700;display:block;margin-bottom:6px;color:var(--ink)}
  .form-mock .field{background:var(--tint);border:1px solid var(--line);border-radius:10px;height:46px;margin-bottom:16px}
  .form-mock .field.ta{height:auto;padding:11px 14px;font-size:13px;color:var(--ink-soft)}
</style>
