---
/**
 * Header.astro — 固定ヘッダー(ロゴ + ナビ + 資料DLボタン)。
 * mocks/CARA_TOP_design_mock.html の <header> を移植。
 * アンカーは TOP のセクションを指すため、下層ページからでも飛べるよう '/' 始まりにしている。
 */

interface Props {
  /** 資料ダウンロードCTAのリンク先 */
  ctaHref?: string;
  /** カレント表示にするナビの href(例 '/webinars') */
  navCurrent?: string;
}

const { ctaHref = '/#contact', navCurrent } = Astro.props;

const navLinks = [
  { href: '/#about', label: 'CARAとは' },
  { href: '/#reasons', label: '選ばれる理由' },
  { href: '/#demo', label: '実演イメージ' },
  { href: '/#cases', label: '導入事例' },
  { href: '/#faq', label: 'FAQ' },
  // TOPモックは「ウェビナー・資料」1項目だったが、下層ページが分かれたため
  // ウェビナー/資料モックに合わせて2項目に分割している
  { href: '/webinars', label: 'ウェビナー' },
  { href: '/whitepapers', label: '資料' },
];
---

<header>
  <div class="wrap nav">
    <a class="logo" href="/">
      <img class="logo-img" src="/images/cara_logo_color.svg" alt="CARA Platform" width="137" height="28" />
    </a>
    <nav class="nav-links">
      {navLinks.map((l) => (
        <a href={l.href} class:list={{ on: navCurrent === l.href }}>{l.label}</a>
      ))}
    </nav>
    <a class="btn btn-coral nav-cta" href={ctaHref}>
      <svg class="ico"><use href="#i-dl" /></svg>資料ダウンロード
    </a>
  </div>
</header>

<style>
  header{position:sticky;top:0;z-index:90;background:rgba(255,255,255,.92);backdrop-filter:blur(10px);border-bottom:1px solid var(--line)}
  .nav{display:flex;align-items:center;justify-content:space-between;height:68px}
  .logo{display:flex;align-items:center}
  /* 公式ロゴ(カラー版)。高さ基準で置き、幅はアスペクト比まかせ */
  .logo-img{height:28px;width:auto;display:block}
  .nav-links{display:flex;gap:24px;font-size:13.5px;font-weight:700}
  .nav-links a{color:var(--ink-soft)}
  .nav-links a:hover{color:var(--blue)}
  .nav-links a.on{color:var(--blue)}
  /* .btn と同じ詳細度だと読み込み順に左右されるため .btn.nav-cta で確実に上書きする */
  .btn.nav-cta{font-size:13.5px;padding:11px 22px}
  @media(max-width:980px){.nav-links{display:none}}
</style>
